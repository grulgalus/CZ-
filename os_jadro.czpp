standardni

cele_cislo hlavni() {
    vypis << "========================================" << konec_radku;
    vypis << "🔥 cz++ KOMPILOVANY BARE-METAL REZIM 🔥" << konec_radku;
    vypis << "========================================" << konec_radku;
    
    cele_cislo pamet = 1024;
    znak verze = 'A';
    
    vypis << "Nacitam hardware procesoru..." << konec_radku;
    vypis << "Dostupna pamet RAM: " << pamet << " MB" << konec_radku;
    
    cele_cislo pocitadlo = 0;
