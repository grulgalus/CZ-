nacti asyncio

vypis("=" * 60)
vypis("🔥 cz++ LIMITLESS: TEST NEJBRUTALNEJSICH FUNKCI 🔥")
vypis("=" * 60)

# 1. LAMBDA (funkcicka), MAP a FILTER
vypis("\n[1] Anonymni funkce (Lambda), Map a Filter")
cisla = [1, 2, 3, 4, 5]
na_druhou = seznam(namapuj(funkcicka x: mocnina(x, 2), cisla))
suda_cisla = seznam(vyfiltruj(funkcicka x: x % 2 == 0, cisla))
vypis(f"- Cisla na druhou: {na_druhou}")
vypis(f"- Jen suda cisla: {suda_cisla}")

# 2. MAGICKÉ METODY A DEKORÁTORY
vypis("\n[2] Magicke metody a @vlastnost (Property)")
trida Penize:
    definuj __zacatek__(ja, castka):
        ja._castka = castka
        
    @vlastnost
    definuj hodnota(ja):
        vrat ja._castka
        
    definuj __text__(ja):
        vrat f"{ja._castka} Kc"
        
    definuj __secti__(ja, jine_penize):
        vrat Penize(ja.hodnota + jine_penize.hodnota)
        
    definuj __zavolej__(ja):
        vypis("Tato trida byla zavolana jako funkce!")

vyplata = Penize(35000)
bonus = Penize(5000)
celkem = vyplata + bonus  # Zde se vola __secti__!
vypis(f"- Vyplata: {vyplata}")  # Zde se vola __text__!
vypis(f"- Celkem penez po bonusu: {celkem}")
celkem()  # Zde se vola __zavolej__!

# 3. MNOŽINY A SYSTÉM
vypis("\n[3] Mnoziny, vyhodnoceni (Eval) a system")
mnozina_A = mnozina([1, 2, 3])
mnozina_B = mnozina([3, 4, 5])
vypis(f"- Prunik mnozin: {mnozina_A.prunik(mnozina_B)}")

kod_v_textu = "5 * 10 + 2"
vypis(f"- Vyhodnoceni textu (eval) '{kod_v_textu}': {vyhodnot(kod_v_textu)}")

# 4. TEXTOVÉ CHLUBENÍ
vypis("\n[4] Hricky s textem")
textik = "ahoj"
vypis(f"- Velke prvni pismeno: {textik.velke_prvni()}")
vypis(f"- Vyplneno nulami: {textik.vypln_nulami(10)}")
vypis(f"- Je '1234' cislo? {'1234'.je_cislo()}")

# 5. ASYNCHRONNÍ PROGRAMOVÁNÍ (OPRAVDOVÝ HARDCORE!)
vypis("\n[5] Asynchronni funkce (Async / Await)")
asynchronni definuj nacti_data():
    vypis("- (Zacinam nacitat data z internetu...)")
    pockej asyncio.sleep(1)
    vypis("- (Data nactena!)")
    vrat Pravda

asynchronni definuj hlavni_async():
    vysledek = pockej nacti_data()
    pokud vysledek:
        vypis("- Async/Await funguje v cestine dokonale!")

asyncio.run(hlavni_async())

vypis("\n" + "=" * 60)
vypis("🏆 cz++ JE NYNI MOCNEJSI NEZ KDY DRIV! 🏆")
vypis("=" * 60)
