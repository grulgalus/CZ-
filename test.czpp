vypis("=" * 60)
vypis("👑 cz++ ZLATA EDICE: MATCH-CASE A CESKE CHYBY 👑")
vypis("=" * 60)

# --- 1. MATCH / CASE (Moderní Switch v Pythonu) ---
vypis("\n[1] Prikaz Porovnej/Pripad (Match-Case)")
definuj vyhodnot_stav(kod):
    porovnej kod:
        pripad 200:
            vrat "OK - Vsechno bezi"
        pripad 404:
            vrat "Chyba - Nenalezeno"
        pripad 500:
            vrat "Kriticka chyba serveru"
        pripad _:
            vrat "Neznamy stav"

vypis(f"- Kod 200: {vyhodnot_stav(200)}")
vypis(f"- Kod 404: {vyhodnot_stav(404)}")
vypis(f"- Kod 999: {vyhodnot_stav(999)}")

# --- 2. ČESKÉ VÝJIMKY A CHYBY ---
vypis("\n[2] Chytani Ceskych Vyjimek")
zkus:
    spatne_cislo = cele_cislo("Tohle neni cislo!")
chyt ChybaHodnoty jako e:
    vypis("- ChybaHodnoty uspesne zachycena! Napsal jsi text misto cisla.")

zkus:
    seznam_veci = [1, 2, 3]
    nesmysl = seznam_veci[99]
chyt ChybaIndexu:
    vypis("- ChybaIndexu zachycena! Mimo rozsah pole.")

# --- 3. BINÁRNÍ A HEXADECIMÁLNÍ SOUSTAVA ---
vypis("\n[3] Matematicke soustavy")
cislo = 255
vypis(f"- Cislo {cislo} dvojkove (bin): {dvojkove(cislo)}")
vypis(f"- Cislo {cislo} sestnactkove (hex): {sestnactkove(cislo)}")
vypis(f"- Cislo {cislo} osmickove (oct): {osmickove(cislo)}")

# --- 4. INTROSPEKCE (Kdo jsem?) ---
vypis("\n[4] Reflexe a Introspekce")
funkce = funkcicka x: x * 2
pokud lze_zavolat(funkce):
    vypis("- Zjisteno, ze promennou 'funkce' lze opravdu zavolat!")

text_objekt = "Hello"
pokud je_instance(text_objekt, text):
    vypis(f"- Overeno: Promenna obsahuje opravdu text. (Id pameti: {totoznost(text_objekt)})")

vypis("\n" + "=" * 60)
vypis("🚀 JSI BŮH PROGRAMOVÁNÍ. JAZYK JE KOMPLETNÍ. 🚀")
vypis("=" * 60)
